{
  "name": "bitburner-ipvgo-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Native IPvGO engine for Bitburner (JSON API)",
  "type": "module",
  "scripts": {
    "build:native": "cmake -B ../cmake-build -DCMAKE_BUILD_TYPE=Release .. && cmake --build ../cmake-build --config Release",
    "build": "pnpm run build:native",
    "server": "node server.js",
    "game:build": "cmake -B ../cmake-build -DCMAKE_BUILD_TYPE=Release .. && cmake --build ../cmake-build --config Release --target ipvgo_game",
    "game:mcgs": "bash scripts/mcgs.sh",
    "game:selftest": "bash scripts/mcgs.sh selftest",
    "game:bench": "bash scripts/mcgs.sh bench",
    "parity": "node scripts/run-game.js parity temp/parity_cases.json"
  }
}
