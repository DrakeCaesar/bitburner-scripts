{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "types": ["vite/client", "node"],
    "strict": true,
    "allowJs": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "inlineSourceMap": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "/src/*": ["./src/*"],
      "@ns": ["./NetscriptDefinitions.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "bench/dnet/dnetSolverBenchCore.ts",
    "bench/koth/kingOfTheHillCore.ts",
    "bench/koth/kingOfTheHillVizWorker.ts",
    "bench/stock/stockBenchCore.ts",
    "bench/stock/stockTraderBench.ts",
    "bench/stock/stockVizWorker.ts",
    "NetscriptDefinitions.d.ts",
    "stockApi.d.ts",
    "global.d.ts",
    "types/viteburner.d.ts",
    "vite.config.mts",
    "vite.tools.config.mts"
  ]
}
